APP_NAME=RideSphere
APP_ENV=development
API_PREFIX=/api
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL=postgresql+psycopg://ridesphere:replace_with_local_password@localhost:5432/ridesphere
DATABASE_RETRY_ATTEMPTS=10
DATABASE_RETRY_DELAY_SECONDS=2
JWT_SECRET_KEY=replace_with_secure_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PAYMENT_BASE_FARE=4.5
PAYMENT_DISTANCE_RATE_PER_KM=1.75
PAYMENT_DURATION_RATE_PER_MINUTE=0.35
PAYMENT_CURRENCY=USD
MONGODB_ENABLED=false
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=ridesphere
MONGODB_EVENTS_COLLECTION=operational_events
MONGODB_CONNECT_TIMEOUT_MS=1000
REDIS_URL=redis://localhost:6379/0
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_BLOB_STORAGE_ACCOUNT_URL=
AZURE_BLOB_STORAGE_CONTAINER=
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true
CELERY_WORKER_LOG_LEVEL=INFO
CELERY_DEFAULT_QUEUE=ridesphere
CELERY_TASK_MAX_RETRIES=3
